ADMIN_PASSWORD=change-me
SESSION_SECRET=replace-with-a-random-64-character-secret
# Local / persistent Node.js server only. Delete DATA_DIR from Vercel settings.
DATA_DIR=./data
# Set true when deployed behind HTTPS.
COOKIE_SECURE=false
# Vercel: connect a PRIVATE Blob store; this variable is added by Vercel.
# BLOB_READ_WRITE_TOKEN=
# Optional: exact public origin. Omit to support both production and preview hosts.
# APP_ORIGIN=https://whatsapp-conversation.vercel.app
